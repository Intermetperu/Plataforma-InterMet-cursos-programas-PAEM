# InterMet: lo que NO se sube al repositorio
# ---------------------------------------------------------------
# Copia de la base de datos (usuarios, pedidos, sesiones)
/database/*.sql
# Links de descarga (WeTransfer) de los cursos pagados: privados
/database/data/links-pago-2026.txt
# Imágenes subidas desde el panel (cursos y programas): viven en el servidor
/public/uploads/*
!/public/uploads/.gitkeep
